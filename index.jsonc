{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "gg_is_flutter",

  // 1-2 sentence summary about this repo.
  "summary": "Tells whether a directory holds a Flutter project or a plain Dart project.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "project detection: isFlutterDir(dir), isFlutter for the working directory",
    "switches for tests: testIsFlutter, testResetIsFlutter",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {},

    // "<repo-b>": "why / API"
    "usedBy": {
      "gg_test": "flutter test or dart test",
      "gg_publish": "flutter or dart when publishing",
      "gg_one_core": "flutter or dart in the checks",
    },
  },
}
